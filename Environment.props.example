<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Copy to Environment.props. Paths must be written as seen from WSL/Linux. -->
    <!-- Example: /mnt/c/Program Files (x86)/Steam/steamapps/common/Valheim -->
    <VALHEIM_INSTALL>/mnt/c/Program Files (x86)/Steam/steamapps/common/Valheim</VALHEIM_INSTALL>
    <VALHEIM_MANAGED>$(VALHEIM_INSTALL)/valheim_Data/Managed</VALHEIM_MANAGED>
    <BEPINEX_PATH>$(VALHEIM_INSTALL)/BepInEx</BEPINEX_PATH>
    <MOD_DEPLOYPATH>$(VALHEIM_INSTALL)/BepInEx/plugins/ValheimSuite</MOD_DEPLOYPATH>
  </PropertyGroup>
</Project>
